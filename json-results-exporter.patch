+"""
+JSON Results exporter for Prowler.
+
+This module implements the ``json-results`` output format, which exports
+**every** executed check — not just failed findings.  Unlike the existing
+``json-ocsf`` exporter (which returns early when the findings list is empty
+and therefore never creates an output file when all checks pass), the
+``JSONResults`` exporter **always** writes a file, even when there are zero
+findings.
+
+The output is a JSON array of objects, one per executed check, with a rich
+schema designed for ingestion into downstream CSPM dashboards (e.g. a
+Cloudflare Worker + D1 database).
+"""
+
+import json
+import os
+from datetime import datetime
+from typing import Any, Dict, List, Optional
+
+from prowler.config.config import timestamp_iso
+from prowler.lib.logger import logger
+from prowler.lib.outputs.finding import Finding
+from prowler.lib.outputs.output import Output
+from prowler.lib.outputs.utils import unroll_dict, unroll_list
+
+
+class JSONResults(Output):
+    """
+    JSON Results exporter that serializes every executed check.
+
+    Unlike the OCSF exporter, this class:
+
+    * **Always** creates the output file — even when ``findings`` is empty.
+    * Does **not** return early when there are no findings.
+    * Produces a flat, dashboard-friendly JSON schema with every field
+      requested by the CSPM platform.
+
+    Attributes:
+        _data: A list of dictionaries, one per executed check.
+        _file_descriptor: A file descriptor to write the results to a file.
+    """
+
+    def __init__(
+        self,
+        findings: List[Finding],
+        file_path: str = None,
+        file_extension: str = "",
+        from_cli: bool = True,
+    ) -> None:
+        """Initialize the JSONResults exporter.
+
+        Overrides ``Output.__init__`` so that the file is always created,
+        even when ``findings`` is empty.  The parent class skips
+        ``transform()`` and ``create_file_descriptor()`` when the findings
+        list is falsy, which is exactly the behaviour we need to avoid.
+
+        Args:
+            findings: List of ``Finding`` objects (may be empty).
+            file_path: Path to the output file.
+            file_extension: File extension override.
+            from_cli: Whether the exporter is invoked from the CLI.
+        """
+        # Initialise the parent without calling transform — we handle that
+        # ourselves below so that an empty findings list still produces a
+        # file.
+        self._data: list = []
+        self.close_file = False
+        self.file_path = file_path
+        self._file_descriptor = None
+        self._from_cli = from_cli
+
+        if not file_extension and file_path:
+            from pathlib import Path
+
+            self._file_extension = "".join(Path(file_path).suffixes)
+        if file_extension:
+            self._file_extension = file_extension
+            self.file_path = f"{file_path}{self.file_extension}"
+
+        # Always transform — even when findings is empty — so that the
+        # output file is always generated.
+        self.transform(findings)
+        if not self._file_descriptor and file_path:
+            self.create_file_descriptor(self.file_path)
+
+    def transform(self, findings: List[Finding]) -> None:
+        """Transform every ``Finding`` into a flat JSON-serializable dict.
+
+        Each finding is mapped to the schema requested by the CSPM platform:
+
+        ``scan_id``, ``provider``, ``service``, ``account_id``,
+        ``account_name``, ``region``, ``resource_uid``, ``resource_name``,
+        ``resource_type``, ``check_id``, ``check_title``,
+        ``check_description``, ``status``, ``status_code``, ``severity``,
+        ``risk``, ``categories``, ``compliance_frameworks``, ``tags``,
+        ``execution_time``, ``timestamp``, ``remediation``,
+        ``documentation_url``, ``metadata``, ``raw_result``.
+
+        Args:
+            findings: A list of ``Finding`` objects.
+        """
+        try:
+            for finding in findings:
+                record = self._finding_to_dict(finding)
+                self._data.append(record)
+        except Exception as error:
+            logger.error(
+                f"{error.__class__.__name__}[{error.__traceback__.tb_lineno}]: {error}"
+            )
+
+    def batch_write_data_to_file(self) -> None:
+        """Write the transformed data to a JSON file.
+
+        Always writes a valid JSON array (``[]`` when there are no findings),
+        guaranteeing that the output file exists and is parseable.
+        """
+        try:
+            if (
+                getattr(self, "_file_descriptor", None)
+                and not self._file_descriptor.closed
+            ):
+                # Write a JSON array — always, even when _data is empty.
+                json_output = json.dumps(self._data, indent=2, default=str)
+                self._file_descriptor.write(json_output)
+                if self.close_file or self._from_cli:
+                    self._file_descriptor.close()
+        except OSError:
+            # Propagate unrecoverable I/O errors (e.g. ENOSPC) so the caller
+            # can fail fast instead of producing a corrupt output file.
+            raise
+        except Exception as error:
+            logger.error(
+                f"{error.__class__.__name__}[{error.__traceback__.tb_lineno}]: {error}"
+            )
+
+    # ------------------------------------------------------------------
+    # Internal helpers
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _finding_to_dict(finding: Finding) -> Dict[str, Any]:
+        """Convert a single ``Finding`` into the JSON-results schema dict.
+
+        Args:
+            finding: A ``Finding`` Pydantic model instance.
+
+        Returns:
+            A flat dictionary with all schema fields populated.
+        """
+        metadata = finding.metadata
+
+        # Build the remediation sub-dict
+        remediation: Dict[str, Any] = {}
+        if metadata.Remediation:
+            remediation = {
+                "recommendation_text": metadata.Remediation.Recommendation.Text,
+                "recommendation_url": metadata.Remediation.Recommendation.Url,
+                "code": {
+                    "native_iac": metadata.Remediation.Code.NativeIaC,
+                    "terraform": metadata.Remediation.Code.Terraform,
+                    "cli": metadata.Remediation.Code.CLI,
+                    "other": metadata.Remediation.Code.Other,
+                },
+            }
+
+        # Build the metadata sub-dict (lowercase keys for consistency)
+        metadata_dict: Dict[str, Any] = {}
+        if metadata:
+            metadata_dict = metadata.dict()
+
+        # Determine the status code and human-readable status
+        status_code = finding.status.value if hasattr(finding.status, "value") else str(finding.status)
+        status = status_code
+
+        # Build the compliance frameworks list
+        compliance_frameworks: List[str] = []
+        if finding.compliance:
+            compliance_frameworks = list(finding.compliance.keys())
+
+        # Build the tags dict
+        tags: Dict[str, str] = finding.resource_tags if finding.resource_tags else {}
+
+        # Determine the documentation URL
+        documentation_url = metadata.RelatedUrl or ""
+
+        # Determine the scan_id
+        scan_id = f"prowler-{finding.provider}-{timestamp_iso}"
+
+        # Determine the account_id
+        account_id = finding.account_uid or ""
+
+        # Determine the service
+        service = metadata.ServiceName or ""
+
+        # Determine the resource_type
+        resource_type = metadata.ResourceType or ""
+
+        # Determine the check_id
+        check_id = metadata.CheckID or ""
+
+        # Determine the check_title
+        check_title = metadata.CheckTitle or ""
+
+        # Determine the check_description
+        check_description = metadata.Description or ""
+
+        # Determine the severity
+        severity = metadata.Severity.value if hasattr(metadata.Severity, "value") else str(metadata.Severity)
+
+        # Determine the risk
+        risk = metadata.Risk or ""
+
+        # Determine the categories
+        categories: List[str] = metadata.Categories or []
+
+        # Determine the execution_time (not directly available, use 0)
+        execution_time = 0
+
+        # Determine the timestamp
+        if isinstance(finding.timestamp, datetime):
+            timestamp = finding.timestamp.isoformat()
+        else:
+            timestamp = str(finding.timestamp)
+
+        record: Dict[str, Any] = {
+            "scan_id": scan_id,
+            "provider": finding.provider,
+            "service": service,
+            "account_id": account_id,
+            "account_name": finding.account_name or "",
+            "region": finding.region or "",
+            "resource_uid": finding.resource_uid or "",
+            "resource_name": finding.resource_name or "",
+            "resource_type": resource_type,
+            "check_id": check_id,
+            "check_title": check_title,
+            "check_description": check_description,
+            "status": status,
+            "status_code": status_code,
+            "severity": severity,
+            "risk": risk,
+            "categories": categories,
+            "compliance_frameworks": compliance_frameworks,
+            "tags": tags,
+            "execution_time": execution_time,
+            "timestamp": timestamp,
+            "remediation": remediation,
+            "documentation_url": documentation_url,
+            "metadata": metadata_dict,
+            "raw_result": finding.raw,
+        }
+
+        return record
