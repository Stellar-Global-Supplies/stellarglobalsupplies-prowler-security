+"""
+Unit tests for the ``json-results`` output exporter.
+
+These tests verify that:
+
+* The exporter always creates an output file, even when there are zero
+  findings.
+* Every ``Finding`` is serialized into the expected JSON schema.
+* All statuses (PASS, FAIL, MANUAL, MUTED) are handled correctly.
+* The output is valid JSON and contains the required top-level fields.
+"""
+
+import json
+import os
+import tempfile
+from datetime import datetime, timezone
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from prowler.lib.outputs.finding import Finding
+from prowler.lib.outputs.json_results.json_results import JSONResults
+from prowler.lib.outputs.utils import unroll_tags
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def sample_check_metadata():
