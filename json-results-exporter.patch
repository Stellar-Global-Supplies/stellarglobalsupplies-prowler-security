+    metadata.Severity = "medium"
+    metadata.ResourceType = "AWS::S3::Bucket"
+    metadata.Description = "Ensure S3 buckets are not publicly accessible"
+    metadata.Risk = "Public read access exposes sensitive data"
+    metadata.RelatedUrl = ""
+    metadata.Remediation = MagicMock()
+    metadata.Remediation.Recommendation.Text = "Remove public access"
+    metadata.Remediation.Recommendation.Url = "https://hub.prowler.com/..."
+    metadata.Remediation.Code.NativeIaC = ""
+    metadata.Remediation.Code.Terraform = ""
+    metadata.Remediation.Code.CLI = ""
+    metadata.Remediation.Code.Other = ""
+    metadata.Categories = ["internet-exposed"]
+    metadata.DependsOn = []
+    metadata.RelatedTo = []
+    metadata.Notes = ""
+    metadata.AdditionalURLs = []
+    return metadata
+
+
+@pytest.fixture
+def sample_finding_pass(sample_check_metadata):
+    """Return a PASS ``Finding``."""
+    return Finding(
+        auth_method="profile: default",
+        timestamp=datetime(2025, 1, 15, 10, 30, 0, tzinfo=timezone.utc),
+        account_uid="123456789012",
+        account_name="production",
+        metadata=sample_check_metadata,
+        uid="prowler-aws-s3_bucket_public_read-123456789012-us-east-1-my-bucket",
+        status="PASS",
+        status_extended="Bucket is not publicly accessible",
+        muted=False,
+        resource_uid="arn:aws:s3:::my-bucket",
+        resource_metadata={},
+        resource_name="my-bucket",
+        resource_details="Bucket ACL does not allow public access",
+        resource_tags={"Environment": "production"},
+        region="us-east-1",
+        compliance={"cis_3.0_aws": ["1.2.3"]},
+        raw={"bucket_name": "my-bucket"},
+    )
